# Copy to .env for local development. Identifiers ONLY — no secrets or tokens here.
# The git post-checkout hook rewrites LAKEBASE_BRANCH_ID + STREAMLIT_PORT per worktree.
DATABRICKS_CONFIG_PROFILE=DEFAULT
LAKEBASE_PROJECT_ID=todo-branching-demo
LAKEBASE_BRANCH_ID=production
LAKEBASE_ENDPOINT_ID=primary
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_SCHEMA=todo_app
STREAMLIT_PORT=8501
